 use crate::model::style::Alignment;
 use crate::model::table::VerticalAlign;
 
+// Only an ordinary horizontal cell with one paragraph-relative Square
+// picture can share its cached exclusion across semantic paragraphs. Keep
+// TAC, other wrap modes, captions and unsupported cell controls unchanged.
+fn embedded_cell_square_picture(cell: &crate::model::table::Cell) -> Option<(usize, usize)> {
+    use crate::model::shape::{HorzRelTo, TextWrap, VertRelTo};
+    if cell.text_direction != 0 || cell.vertical_align != VerticalAlign::Top
+        || cell.width as i32 <= 0 || cell.height as i32 <= 0
+    {
+        return None;
+    }
+    let mut picture = None;
+    for (pi, para) in cell.paragraphs.iter().enumerate() {
+        if para.line_segs.is_empty() || para.line_segs.iter().any(|line| {
+            line.vertical_pos < 0 || line.column_start < 0 || line.segment_width <= 0
+                || line.column_start.checked_add(line.segment_width)
+                    .is_none_or(|end| end > cell.width as i32)
+                || line.text_height <= 0 || line.line_height < line.text_height
+                || line.baseline_distance <= 0 || line.baseline_distance > line.text_height
+        }) {
+            return None;
+        }
+        for (ci, control) in para.controls.iter().enumerate() {
+            let Control::Picture(pic) = control else { return None; };
+            let common = &pic.common;
+            if picture.is_some() || common.treat_as_char || !common.flow_with_text
+                || common.text_wrap != TextWrap::Square || common.vert_rel_to != VertRelTo::Para
+                || !matches!(common.horz_rel_to, HorzRelTo::Para | HorzRelTo::Column)
+                || common.width as i32 <= 0 || common.height as i32 <= 0
+                || (common.horizontal_offset as i32) < 0 || (common.vertical_offset as i32) < 0
+                || pic.caption.is_some()
+            {
+                return None;
+            }
+            picture = Some((pi, ci));
+        }
+    }
+    picture
+}
+
+fn first_rendered_line_y(nodes: &[RenderNode]) -> Option<f64> {
+    for node in nodes {
+        if matches!(&node.node_type, RenderNodeType::TextLine(_)) {
+            return Some(node.bbox.y);
+        }
+        if let Some(y) = first_rendered_line_y(&node.children) { return Some(y); }
+    }
+    None
+}
