+//! Exact aliases of loaded faces, only after the ordinary family query fails.
+//!
+//! Legacy family/name1 can differ from the typographic family/name16 exposed
+//! by a platform font manager. Never infer a weight from a family spelling.
+
+#[derive(Clone)]
+pub(crate) struct FaceAlias<T> {
+    pub(crate) id: T,
+    pub(crate) names: Vec<String>,
+    pub(crate) weight: u16,
+    pub(crate) width: u16,
+    /// OpenType/Skia upright=0, italic=1, oblique=2.
+    pub(crate) slant: u8,
+}
+
+fn qualified_name(name: &str) -> String {
+    name.chars()
+        .filter(|ch| !matches!(ch, ' ' | '-'))
+        .flat_map(char::to_lowercase)
+        .collect()
+}
+
+pub(crate) fn table_alias_names(data: &[u8]) -> Vec<String> {
+    let Some(table) = ttf_parser::name::Table::parse(data) else {
+        return Vec::new();
+    };
+    let mut names: Vec<String> = table.names.into_iter()
+        .filter(|name| matches!(name.name_id, 1 | 6))
+        .filter_map(|name| name.to_string())
+        .filter(|name| !name.trim().is_empty())
+        .collect();
+    names.sort();
+    names.dedup();
+    names
+}
+
+pub(crate) fn exact_face_alias<T: Clone + PartialEq>(
+    faces: &[FaceAlias<T>], requested: &str, weight: u16, width: u16, slant: u8,
+) -> Option<T> {
+    let requested = qualified_name(requested.trim());
+    if requested.is_empty() {
+        return None;
+    }
+    let mut selected = None;
+    for face in faces {
+        if face.slant != slant || face.width != width
+            // Normal text may name an intrinsically heavy face. Explicit
+            // bold must still be provided by a real bold face, never synthesis.
+            || !(weight == 400 || (weight >= 600 && face.weight >= 600) || weight == face.weight)
+            || !face.names.iter().any(|name| qualified_name(name) == requested)
+        {
+            continue;
+        }
+        if selected.as_ref().is_some_and(|id| *id != face.id) {
+            return None; // Multiple different qualified faces: keep fallback.
+        }
+        selected = Some(face.id.clone());
+    }
+    selected
+}
+
+pub(crate) fn fontdb_aliases(db: &usvg::fontdb::Database) -> Vec<FaceAlias<usvg::fontdb::ID>> {
+    let mut identities = std::collections::HashSet::new();
+    db.faces().filter_map(|face| {
+        let (identity, names) = db.with_face_data(face.id, |data, index| {
+            let parsed = ttf_parser::Face::parse(data, index).ok()?;
+            Some(((blake3::hash(data), index), table_alias_names(parsed.raw_face().table(ttf_parser::Tag::from_bytes(b"name"))?)))
+        })??;
+        // Identical files may be loaded through both system and --font-path
+        // directories. They represent one physical face, not ambiguity.
+        if !identities.insert(identity) { return None; }
+        Some(FaceAlias { id: face.id, names, weight: face.weight.0,
+            width: face.stretch.to_number(), slant: match face.style {
+                usvg::fontdb::Style::Normal => 0,
+                usvg::fontdb::Style::Italic => 1,
+                usvg::fontdb::Style::Oblique => 2,
+            } })
+    }).collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn face(id: u8, weight: u16, slant: u8) -> FaceAlias<u8> {
+        FaceAlias { id, names: vec!["Example Heavy".into(), "Example-Heavy".into()], weight, width: 5, slant }
+    }
+
+    #[test]
+    fn qualified_alias_preserves_intrinsic_face_and_rejects_unsupported_requests() {
+        let fonts = vec![face(1, 900, 0)];
+        assert_eq!(exact_face_alias(&fonts, "Example Heavy", 400, 5, 0), Some(1));
+        assert_eq!(exact_face_alias(&fonts, "example-heavy", 700, 5, 0), Some(1));
+        for name in ["Example", "Example Heavy Italic", "Example_Heavy", "Unknown Black", "Blackadder ITC", ""] {
+            assert_eq!(exact_face_alias(&fonts, name, 400, 5, 0), None);
+        }
+        assert_eq!(exact_face_alias(&fonts, "Example Heavy", 400, 5, 1), None);
+        assert_eq!(exact_face_alias(&fonts, "Example Heavy", 400, 3, 0), None);
+        assert_eq!(exact_face_alias(&[face(1, 400, 0)], "Example Heavy", 700, 5, 0), None);
+    }
+
+    #[test]
+    fn ambiguous_distinct_faces_retain_fallback_but_duplicate_identity_is_safe() {
+        assert_eq!(exact_face_alias(&[face(1, 900, 0), face(2, 900, 0)], "Example Heavy", 400, 5, 0), None);
+        assert_eq!(exact_face_alias(&[face(1, 900, 0), face(1, 900, 0)], "Example Heavy", 400, 5, 0), Some(1));
+        assert_eq!(exact_face_alias(&[face(1, 900, 0), face(2, 900, 1)], "Example Heavy", 400, 5, 1), Some(2));
+    }
+}
