+fn exact_font_resolver(db: &usvg::fontdb::Database) -> usvg::FontResolver<'static> {
+    use super::font_alias::{exact_face_alias, fontdb_aliases};
+    use usvg::fontdb::{Family, Query, Style, Weight};
+    let aliases = fontdb_aliases(db);
+    let default = usvg::FontResolver::default_font_selector();
+    let fallback = usvg::FontResolver::default_fallback_selector();
+    let legacy_faces = std::sync::Arc::new(std::sync::Mutex::new(
+        std::collections::HashMap::<usvg::fontdb::ID, Option<usvg::fontdb::ID>>::new()));
+    let selected_legacy_faces = legacy_faces.clone();
+    usvg::FontResolver {
+        select_font: Box::new(move |font, db| {
+            let style = match font.style() {
+                usvg::FontStyle::Normal => Style::Normal,
+                usvg::FontStyle::Italic => Style::Italic,
+                usvg::FontStyle::Oblique => Style::Oblique,
+            };
+            let stretch = match font.stretch() {
+                usvg::FontStretch::UltraCondensed => usvg::fontdb::Stretch::UltraCondensed,
+                usvg::FontStretch::ExtraCondensed => usvg::fontdb::Stretch::ExtraCondensed,
+                usvg::FontStretch::Condensed => usvg::fontdb::Stretch::Condensed,
+                usvg::FontStretch::SemiCondensed => usvg::fontdb::Stretch::SemiCondensed,
+                usvg::FontStretch::Normal => usvg::fontdb::Stretch::Normal,
+                usvg::FontStretch::SemiExpanded => usvg::fontdb::Stretch::SemiExpanded,
+                usvg::FontStretch::Expanded => usvg::fontdb::Stretch::Expanded,
+                usvg::FontStretch::ExtraExpanded => usvg::fontdb::Stretch::ExtraExpanded,
+                usvg::FontStretch::UltraExpanded => usvg::fontdb::Stretch::UltraExpanded,
+            };
+            // Match CSS families in the original order. The default selector
+            // already appends a generic serif fallback, so only consulting it
+            // first would hide a failed requested-family lookup.
+            for family in font.families() {
+                let requested = match family {
+                    usvg::FontFamily::Named(name) => Family::Name(name),
+                    usvg::FontFamily::Serif => Family::Serif,
+                    usvg::FontFamily::SansSerif => Family::SansSerif,
+                    usvg::FontFamily::Monospace => Family::Monospace,
+                    usvg::FontFamily::Cursive => Family::Cursive,
+                    usvg::FontFamily::Fantasy => Family::Fantasy,
+                };
+                if let Some(id) = db.query(&Query { families: &[requested], weight: Weight(font.weight()), stretch, style }) {
+                    return Some(id);
+                }
+                if let usvg::FontFamily::Named(name) = family {
+                    let slant = match style { Style::Normal => 0, Style::Italic => 1, Style::Oblique => 2 };
+                    if let Some(id) = exact_face_alias(&aliases, name, font.weight(), stretch.to_number(), slant) {
+                        let legacy = default(font, db);
+                        let mut selections = selected_legacy_faces.lock().ok()?;
+                        // A face can be requested with different CSS fallback
+                        // chains. Without the original font specification in
+                        // select_fallback, conflicting chains must fail closed.
+                        if selections.get(&id).is_some_and(|previous| *previous != legacy) {
+                            return legacy;
+                        }
+                        selections.insert(id, legacy);
+                        return Some(id);
+                    }
+                }
+            }
+            default(font, db)
+        }),
+        select_fallback: Box::new(move |character, used, db| {
+            let legacy = legacy_faces.lock().ok()?.get(used.first()?).copied();
+            let Some(legacy) = legacy else { return fallback(character, used, db); };
+            let legacy = legacy?;
+            // Recovering a Latin face must not change the previous CJK or
+            // other missing-glyph fallback. Reuse the old selected face first,
+            // then preserve the original fallback selector and its base style.
+            if !used.contains(&legacy) && db.with_face_data(legacy, |data, index| {
+                ttf_parser::Face::parse(data, index).ok()
+                    .and_then(|face| face.glyph_index(character)).is_some()
+            }).unwrap_or(false) {
+                return Some(legacy);
+            }
+            let mut previous = vec![legacy];
+            previous.extend(used.iter().copied().filter(|id| *id != legacy));
+            fallback(character, &previous, db)
+        }),
+    }
+}
