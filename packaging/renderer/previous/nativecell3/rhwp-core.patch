+use crate::renderer::font_alias::{exact_face_alias, table_alias_names, FaceAlias};
+
+pub(super) struct LoadedFaceAliases {
+    faces: Vec<Typeface>,
+    aliases: Vec<FaceAlias<usize>>,
+}
+
+impl LoadedFaceAliases {
+    pub(super) fn new(manager: &FontMgr, custom: &HashMap<String, Typeface>) -> Self {
+        let mut faces: Vec<Typeface> = custom.values().cloned().collect();
+        for family in 0..manager.count_families() {
+            let mut styles = manager.new_style_set(family);
+            for index in 0..styles.count() {
+                if let Some(face) = styles.new_typeface(index) { faces.push(face); }
+            }
+        }
+        let mut seen = HashSet::new();
+        faces.retain(|face| seen.insert(face.unique_id()));
+        let aliases = faces.iter().enumerate().filter_map(|(id, face)| {
+            let data = face.copy_table_data(u32::from_be_bytes(*b"name"))?;
+            let names = table_alias_names(data.as_bytes());
+            let style = face.font_style();
+            Some(FaceAlias { id, names, weight: *style.weight() as u16,
+                width: *style.width() as u16, slant: style.slant() as u8 })
+        }).collect();
+        Self { faces, aliases }
+    }
+
+    pub(super) fn find(&self, family: &str, style: FontStyle) -> Option<Typeface> {
+        let index = exact_face_alias(&self.aliases, family, *style.weight() as u16,
+                                    *style.width() as u16, style.slant() as u8)?;
+        self.faces.get(index).cloned()
+    }
+}
