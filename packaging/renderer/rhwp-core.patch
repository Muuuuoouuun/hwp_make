 #[cfg(test)]
+mod inline_tab_order_tests {
+    use super::*;
+    use crate::model::paragraph::{CharShapeRef, LineSeg};
+    use crate::renderer::composer::ComposedParagraph;
+    use crate::renderer::style_resolver::{ResolvedCharStyle, ResolvedParaStyle};
+
+    fn fixture(alignment: Alignment) -> (ComposedParagraph, ResolvedStyleSet) {
+        // Different language and character-shape boundaries split the two tabs
+        // on each line into different shaped runs. The second line also tests
+        // paragraph-global tab order when only a later line is laid out.
+        let text = "A\t한\tC\nD\t語\tF";
+        let para = Paragraph {
+            text: text.into(),
+            char_count: text.chars().count() as u32 + 1,
+            char_offsets: (0..text.chars().count() as u32).collect(),
+            char_shapes: vec![
+                CharShapeRef {
+                    start_pos: 0,
+                    char_shape_id: 0,
+                },
+                CharShapeRef {
+                    start_pos: 2,
+                    char_shape_id: 1,
+                },
+                CharShapeRef {
+                    start_pos: 4,
+                    char_shape_id: 0,
+                },
+                CharShapeRef {
+                    start_pos: 6,
+                    char_shape_id: 1,
+                },
+                CharShapeRef {
+                    start_pos: 8,
+                    char_shape_id: 0,
+                },
+            ],
+            line_segs: [0, 6]
+                .into_iter()
+                .map(|text_start| LineSeg {
+                    text_start,
+                    line_height: 1200,
+                    text_height: 1200,
+                    baseline_distance: 960,
+                    segment_width: 30000,
+                    ..Default::default()
+                })
+                .collect(),
+            tab_extended: [750, 2250, 3750, 5250]
+                .into_iter()
+                .map(|width| [width, 0, 0x0100, 0, 0, 0, 9])
+                .collect(),
+            ..Default::default()
+        };
+        let styles = ResolvedStyleSet {
+            char_styles: vec![
+                ResolvedCharStyle {
+                    font_size: 12.0,
+                    ..Default::default()
+                },
+                ResolvedCharStyle {
+                    font_size: 16.0,
+                    bold: true,
+                    ..Default::default()
+                },
+            ],
+            para_styles: vec![ResolvedParaStyle {
+                alignment,
+                ..Default::default()
+            }],
+            ..Default::default()
+        };
+        let composed = compose_paragraph(&para);
+        assert_eq!(composed.lines.len(), 2);
+        assert!(composed.lines.iter().all(|line| line.runs.len() >= 3));
+        assert!(composed.lines[0].runs.iter().any(|r| r.lang_index == 0));
+        assert!(composed.lines[0].runs.iter().any(|r| r.lang_index == 1));
+        assert!(composed.lines[0].runs.iter().any(|r| r.char_style_id == 1));
+        (composed, styles)
+    }
+
+    fn layout(composed: &ComposedParagraph, styles: &ResolvedStyleSet, start: usize) -> RenderNode {
+        let mut tree = PageRenderTree::new(0, 600.0, 800.0);
+        let area = LayoutRect {
+            x: 20.0,
+            y: 30.0,
+            width: 400.0,
+            height: 700.0,
+        };
+        let mut column = RenderNode::new(
+            tree.next_id(),
+            RenderNodeType::Column(0),
+            BoundingBox::new(area.x, area.y, area.width, area.height),
+        );
+        LayoutEngine::new(96.0).layout_composed_paragraph(
+            &mut tree,
+            &mut column,
+            composed,
+            styles,
+            &area,
+            area.y,
+            start,
+            composed.lines.len(),
+            0,
+            1,
+            None,
+            false,
+            0.0,
+            None,
+            None,
+            None,
+            None,
+        );
+        column
+    }
+
+    fn glyph(node: &RenderNode, wanted: char) -> (f64, f64) {
+        if let RenderNodeType::TextRun(run) = &node.node_type {
+            if let Some(i) = run.text.chars().position(|c| c == wanted) {
+                let positions = compute_char_positions(&run.text, &run.style);
+                return (node.bbox.x + positions[i], positions[i + 1] - positions[i]);
+            }
+        }
+        for child in &node.children {
+            let found = glyph(child, wanted);
+            if found.0.is_finite() {
+                return found;
+            }
+        }
+        (f64::NAN, f64::NAN)
+    }
+
+    fn close(actual: f64, expected: f64) {
+        assert!(
+            (actual - expected).abs() < 0.02,
+            "expected {expected}, got {actual}"
+        );
+    }
+
+    #[test]
+    fn inline_tabs_follow_style_language_runs_and_lines() {
+        let (composed, styles) = fixture(Alignment::Left);
+        let result = layout(&composed, &styles, 0);
+        for (before, after, width) in [
+            ('A', '한', 10.0),
+            ('한', 'C', 30.0),
+            ('D', '語', 50.0),
+            ('語', 'F', 70.0),
+        ] {
+            let a = glyph(&result, before);
+            let b = glyph(&result, after);
+            close(b.0 - a.0 - a.1, width);
+        }
+        let later_line = layout(&composed, &styles, 1);
+        for ch in ['D', '語', 'F'] {
+            close(glyph(&later_line, ch).0, glyph(&result, ch).0);
+        }
+    }
+
+    #[test]
+    fn inline_tab_width_changes_only_its_following_text() {
+        let (mut composed, styles) = fixture(Alignment::Left);
+        let baseline = layout(&composed, &styles, 0);
+        composed.tab_extended[1][0] += 750;
+        let changed = layout(&composed, &styles, 0);
+        for ch in ['A', '한', 'D', '語', 'F'] {
+            close(glyph(&changed, ch).0, glyph(&baseline, ch).0);
+        }
+        close(glyph(&changed, 'C').0 - glyph(&baseline, 'C').0, 10.0);
+    }
+
+    #[test]
+    fn inline_tab_estimation_matches_rendered_right_alignment() {
+        let (composed, styles) = fixture(Alignment::Right);
+        let result = layout(&composed, &styles, 0);
+        for (first, middle, end, tabs) in [('A', '한', 'C', 40.0), ('D', '語', 'F', 120.0)] {
+            let last = glyph(&result, end);
+            close(last.0 + last.1, 420.0);
+            let source_width = glyph(&result, first).1 + glyph(&result, middle).1 + last.1 + tabs;
+            close(glyph(&result, first).0, 420.0 - source_width);
+        }
+    }
+
+    #[test]
+    fn inline_tab_leaders_use_the_current_run_record() {
+        let (mut composed, styles) = fixture(Alignment::Left);
+        for (ext, fill) in composed.tab_extended.iter_mut().zip([1, 2, 3, 4]) {
+            ext[1] = fill;
+        }
+        let result = layout(&composed, &styles, 0);
+        let fills: Vec<u8> = result
+            .children
+            .iter()
+            .flat_map(|line| &line.children)
+            .filter_map(|node| match &node.node_type {
+                RenderNodeType::TextRun(run) => {
+                    Some(run.style.tab_leaders.iter().map(|l| l.fill_type))
+                }
+                _ => None,
+            })
+            .flatten()
+            .collect();
+        assert_eq!(fills, vec![1, 2, 3, 4]);
+    }
+
+    #[test]
+    fn inline_tabs_tac_segmentation_keeps_estimate_and_render_aligned() {
+        use crate::renderer::composer::ComposedTextRun;
